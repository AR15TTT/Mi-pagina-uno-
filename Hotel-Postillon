    <script>
        // Establecer fechas predeterminadas en el cotizador (hoy y mañana)
        window.onload = function() {
            const today = new Date();
            const tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);

            document.getElementById('check-in').value = today.toISOString().split('T')[0];
            document.getElementById('check-out').value = tomorrow.toISOString().split('T')[0];
            
            calculateTotal();
            initMap();
            initFAQ();
        };

        // Función para abrir/cerrar menú móvil
        function toggleMenu() {
            const nav = document.getElementById('nav-menu');
            nav.classList.toggle('active');
        }

        // Inicializar el Mapa Interactivo de Leaflet
        function initMap() {
            // Ubicación aproximada detrás de la terminal de ómnibus CDE
            const cdeTerminalLatLng = [-25.5240, -54.6288]; 
            const map = L.map('map').setView(cdeTerminalLatLng, 16);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            // Crear ícono dorado personalizado para el hotel
            const hotelIcon = L.divIcon({
                html: '<div style="background-color:#d4af37; width:20px; height:20px; border-radius:50%; border:3px solid #0b1a21; box-shadow:0 0 10px rgba(0,0,0,0.5);"></div>',
                className: 'custom-icon',
                iconSize: [20, 20]
            });

            L.marker(cdeTerminalLatLng, { icon: hotelIcon }).addTo(map)
                .bindPopup('<b>Hotel Postillon</b><br>Detrás de la Terminal de CDE, Paraguay.<br><a href="https://maps.google.com/?q=-25.5240,-54.6288" target="_blank" style="color:#d4af37; text-decoration:none; font-weight:bold;">Ver en Google Maps</a>')
                .openPopup();
        }

        // Calcular costo total interactivo
        function calculateTotal() {
            const roomPrice = parseFloat(document.getElementById('room-select').value);
            const checkInVal = document.getElementById('check-in').value;
            const checkOutVal = document.getElementById('check-out').value;

            if(!checkInVal || !checkOutVal) return;

            const checkInDate = new Date(checkInVal);
            const checkOutDate = new Date(checkOutVal);

            // Calcular diferencia en milisegundos y luego días
            const diffTime = checkOutDate - checkInDate;
            let diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

            if (diffDays <= 0) {
                diffDays = 1; // Mínimo 1 noche
                // Ajustar check-out para el día siguiente si el usuario eligió mal
                const nextDay = new Date(checkInDate);
                nextDay.setDate(nextDay.getDate() + 1);
                document.getElementById('check-out').value = nextDay.toISOString().split('T')[0];
            }

            const totalPrice = roomPrice * diffDays;
            
            // Formatear precio
            document.getElementById('calculated-price').innerText = "GS. " + totalPrice.toLocaleString('es-PY');
            document.getElementById('nights-display').innerText = diffDays + " Noche(s)";
        }

        // Enviar consulta por Whatsapp estructurada automáticamente
        function sendWhatsAppBooking() {
            const roomSelect = document.getElementById('room-select');
            const roomName = roomSelect.options[roomSelect.selectedIndex].getAttribute('data-name');
            const guests = document.getElementById('guests').value;
            const checkIn = document.getElementById('check-in').value;
            const checkOut = document.getElementById('check-out').value;
            const totalPrice = document.getElementById('calculated-price').innerText;
            const nights = document.getElementById('nights-display').innerText;

            // Formatear texto para WhatsApp
            const message = `Hola Hotel Postillon, quisiera hacer una consulta de reserva:\n\n` + 
                            `🏨 Habitación: *${roomName}*\n` +
                            `👥 Huéspedes: *${guests} Persona(s)*\n` +
                            `📅 Check-In: *${checkIn}*\n` +
                            `📅 Check-Out: *${checkOut}*\n` +
                            `🌙 Duración: *${nights}*\n` +
                            `💰 Presupuesto estimado: *${totalPrice}*\n\n` +
                            `¿Tienen disponibilidad para estas fechas? ¡Muchas gracias!`;

            const encodedMessage = encodeURIComponent(message);
            // Redirección directa al número principal del hotel
            const waUrl = `https://wa.me/595973894369?text=${encodedMessage}`;
            window.open(waUrl, '_blank');
        }

        // Lógica de Preguntas Frecuentes (Acordeón)
        function initFAQ() {
            const questions = document.querySelectorAll('.faq-question');
            questions.forEach(q => {
                q.addEventListener('click', () => {
                    const parent = q.parentElement;
                    parent.classList.toggle('active');
                });
            });
        }
    </script>
</body>
