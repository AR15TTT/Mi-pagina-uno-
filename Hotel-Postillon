                        <div class="room-amenities">
                            <div class="room-amenity"><span>🛏️</span> 2 Camas Ind.</div>
                            <div class="room-amenity"><span>❄️</span> A.A.</div>
                            <div class="room-amenity"><span>📶</span> Wi-Fi Gratis</div>
                        </div>
                        <p style="color:#7f8c8d; margin-bottom: 1rem; font-size: 0.9rem;">Excelente opción para colegas de negocios o amigos. Camas sumamente cómodas y baño privado.</p>
                        <div class="room-price">
                            GS. 200.000 <span>/ noche</span>
                        </div>
                    </div>
                </div>

                <!-- Habitación Triple -->
                <div class="room-card">
                    <div class="room-img" style="background-image: url('https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=600&q=80')">
                    </div>
                    <div class="room-details">
                        <h4>Habitación Familiar Triple</h4>
                        <div class="room-amenities">
                            <div class="room-amenity"><span>🛏️</span> 3 Camas</div>
                            <div class="room-amenity"><span>❄️</span> A.A.</div>
                            <div class="room-amenity"><span>📶</span> Wi-Fi Gratis</div>
                        </div>
                        <p style="color:#7f8c8d; margin-bottom: 1rem; font-size: 0.9rem;">Perfecta para familias o grupos de compradores. Espaciosa, limpia y equipada con el mejor confort.</p>
                        <div class="room-price">
                            GS. 250.000 <span>/ noche</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Cotizador Dinámico -->
    <section class="booking-section" id="reservas">
        <div class="booking-container">
            <h3>Calcula tu Estadía</h3>
            <p>Selecciona tus preferencias y reserva de forma inmediata a través de WhatsApp con tu tarifa calculada.</p>
            
            <div class="booking-form">
                <div class="form-group">
                    <label for="room-select">Tipo de Habitación</label>
